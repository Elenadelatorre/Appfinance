# ==========================================
# Finance App - Configuration Example
# ==========================================
# Copy this file to .env and fill in your values

# === DATABASE ===
MONGO_URL=mongodb://admin:changeme@mongo:27017/?authSource=admin
DB_NAME=finance
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme

# === SECURITY ===
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_DAYS=30

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# === LOGGING ===
LOG_LEVEL=INFO

# === FRONTEND (static) ===
# Set this in frontend/index.html meta[name="finance-api-base"]
# or pass ?api=https://your-backend.example.com once to persist in localStorage.
FINANCE_API_BASE=http://127.0.0.1:8001
